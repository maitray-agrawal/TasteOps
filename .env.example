# ==============================================================================
# TasteOps Environment Configuration
# Copy this file to .env and provide your specific credentials.
# NEVER commit the active .env file or real secrets to version control.
# ==============================================================================

# --- Application Runtime & Server ---
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO

# --- Security & Authentication Boundary ---
TASTEOPS_AUTH_ENFORCED=false
TASTEOPS_API_KEY=tasteops_dev_secret_key_change_in_production
CORS_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000"]

# --- Database & Persistence ---
DATABASE_PATH=storage/tasteops.db
# For PostgreSQL in staging/production:
# DATABASE_URL=postgresql://tasteops:tasteops@localhost:5432/tasteops

# --- Qloo Cultural Intelligence API ---
QLOO_API_KEY=your_qloo_hackathon_api_key_here
QLOO_BASE_URL=https://hackathon.api.qloo.com
QLOO_TIMEOUT_SECONDS=15.0
QLOO_MAX_RETRIES=3
QLOO_RETRY_BACKOFF_FACTOR=0.5
QLOO_CACHE_ENABLED=true
QLOO_CACHE_TTL_SECONDS=3600

# --- External Execution Connectors ---
# Spotify Web API Connector
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Email / Partner Outreach Connector (SendGrid)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=partnerships@tasteops.io

# Procurement & Purchasing Order Connector
PROCUREMENT_API_KEY=
PROCUREMENT_ENDPOINT_URL=https://api.procurement.example.com/v1/orders
