# Qloo Cultural Intelligence Configuration
# Do NOT put real secrets in this file. Copy to .env and insert your real key.
QLOO_API_KEY=your_qloo_hackathon_api_key_here
QLOO_BASE_URL=https://hackathon.api.qloo.com
QLOO_TIMEOUT_SECONDS=15.0
QLOO_MAX_RETRIES=3
QLOO_RETRY_BACKOFF_FACTOR=0.5
QLOO_CACHE_ENABLED=true
QLOO_CACHE_TTL_SECONDS=3600
