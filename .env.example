# ==============================================================================
# TasteOps Deployment & Environment Configuration
# ==============================================================================
# Do NOT commit real secrets to source control.
# Copy this file to .env and insert your real Qloo Hackathon API key.

# --- Qloo Cultural Intelligence Configuration ---
QLOO_API_KEY=your_qloo_hackathon_api_key_here
QLOO_BASE_URL=https://hackathon.api.qloo.com
QLOO_TIMEOUT_SECONDS=15.0
QLOO_MAX_RETRIES=3
QLOO_RETRY_BACKOFF_FACTOR=0.5
QLOO_CACHE_ENABLED=true
QLOO_CACHE_TTL_SECONDS=3600

# --- Server & Deployment Configuration ---
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
TASTEOPS_STORAGE_DIR=storage/workflows
LOG_LEVEL=INFO

